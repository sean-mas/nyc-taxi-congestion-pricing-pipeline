# Copy to .env (cp .env.example .env). Docker Compose, the Python code and dbt all read it.
POSTGRES_HOST=localhost
# 5433 on the host so this project doesn't clash with other course Postgres containers on 5432.
POSTGRES_PORT=5433
POSTGRES_DB=green_taxi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Prefect: use the local server started with 'uv run prefect server start'
# (UI at http://127.0.0.1:4200), not a temporary one per run.
PREFECT_API_URL=http://127.0.0.1:4200/api
# Show the green_taxi module's log lines in the Prefect UI.
PREFECT_LOGGING_EXTRA_LOGGERS=green_taxi
