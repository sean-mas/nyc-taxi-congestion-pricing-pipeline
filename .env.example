# Optional. Without a .env file everything runs on the defaults below.
# Copy it (cp .env.example .env) to watch Prefect runs in the web UI, or to change a setting.

# Prefect: send runs to the local server started with 'uv run prefect server start'
# (web UI at http://127.0.0.1:4200). Without this line, Prefect starts a temporary
# server for each run and doesn't keep the run history.
PREFECT_API_URL=http://127.0.0.1:4200/api

# Postgres in Docker. These are the defaults; change them here if you need to.
# 5433 on the host so this project doesn't clash with other Postgres containers on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=green_taxi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
